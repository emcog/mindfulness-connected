---
interface Props {
	hostedButtonId: string;
	ukPrice: string;
}
const { hostedButtonId, ukPrice } = Astro.props;
---
<div id="paypal-basket">
	<form target="paypal" action="https://www.paypal.com/cgi-bin/webscr" method="post">
		<input type="hidden" name="cmd" value="_s-xclick" />
		<input type="hidden" name="hosted_button_id" value={hostedButtonId} />
		<input type="hidden" name="on0" value="Postage included" />
		<input type="hidden" name="os0" value="UK" />
		<p class="paypal-title">Postage included. UK {ukPrice}</p>
		<input type="hidden" name="currency_code" value="GBP" />
		<input type="image" src="https://www.paypalobjects.com/en_GB/i/btn/btn_cart_LG.gif" style="border:0" name="submit" alt="PayPal – The safer, easier way to pay online!" />
		<img alt="" style="border:0" src="https://www.paypalobjects.com/en_GB/i/scr/pixel.gif" width="1" height="1" />
	</form>
	<div class="shipping-details">
		<p class="shipping-details__text-title"></p>
		<ul class="shipping-details__text">
			<li>All orders are sent within 2 days of receiving payment</li>
			<li>Shipping is second class</li>
			<li>For multiples or bulk, please <a href="/contact-us">contact us</a></li>
		</ul>
	</div>
</div>
