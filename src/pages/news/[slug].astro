---
import { getCollection, render } from 'astro:content';
import BannerPage from '../../layouts/BannerPage.astro';
import DisqusComments from '../../components/DisqusComments.astro';

export async function getStaticPaths() {
	const posts = await getCollection('posts');
	return posts.map((post) => ({
		params: { slug: post.data.permalink.replace('/news/', '') },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<BannerPage title={post.data.title} bannerImage={post.data['banner-image']}>
	<Content />
	{post.data.comments && (
		<DisqusComments identifier={post.data.permalink} title={post.data.title} />
	)}
</BannerPage>
